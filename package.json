{
  "name": "tv-mini-charts",
  "version": "1.0.3",
  "description": "Electron app that displays multiple TradingView mini charts.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dir --arm64",
    "build:mac:universal": "electron-builder --mac dir --universal",
    "verify:builder-proxy": "node scripts/verify-builder-proxy.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "@electron/get@3.1.0": {
      "global-agent": {
        ".": "3.0.0",
        "roarr": "3.3.0"
      }
    }
  },
  "build": {
    "appId": "com.hirotgr.tvminicharts",
    "productName": "TV Mini Charts",
    "copyright": "Copyright © 2026 hirotgr",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "shared/defaults.js",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.finance",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
